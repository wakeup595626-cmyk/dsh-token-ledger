{
  "name": "@dsh-external/dsh-token-ledger",
  "version": "0.1.1",
  "description": "A provider-agnostic cumulative token usage ledger for DeepSeek Harness. | 中文：DSH 全局累积 token 用量账本：实时捕获 + 历史回填。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "telemetry"
  ],
  "homepage": "https://github.com/wakeup595626-cmyk/dsh-token-ledger#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wakeup595626-cmyk/dsh-token-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/wakeup595626-cmyk/dsh-token-ledger/issues"
  },
  "author": "wakeUp595626-cmyk"
}
